// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email    String @unique
  name     String
  username String @unique @default(cuid())
  avatar   String @default("/uploads/default-avatar.jpg")
  password String

  event Event[]

  role ROLE   @default(USER)
  wish Wish[]

  isVerified Boolean @default(false)

  requestsSent     Friends[] @relation("requests_sent")
  requestsReceived Friends[] @relation("requests_received")

  @@map("user")
}

model Token {
  id        String     @id @default(cuid())
  email     String
  token     String     @unique
  type      TOKEN_TYPE
  expiresIn DateTime   @map("expires_in")

  createdAt DateTime @default(now()) @map("createt_at")

  @@map("tokens")
}

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title String
  date  DateTime
  emoji String

  slug String

  user   User   @relation(fields: [userId], references: [id])
  userId String
  wish   Wish[]

  @@map("event")
}

model Wish {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title    String
  emoji    String?
  reserve  Boolean?        @default(false)
  link     String?
  price    Int?
  priority WISH_PRIORITIES
  slug     String
  eventId  String?
  event    Event?          @relation(fields: [eventId], references: [id])

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("wish")
}

model Friends {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status FriendStatus @default(PENDING)

  sender   User   @relation("requests_sent", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("requests_received", fields: [receiverId], references: [id])
  receiverId String

  @@unique([senderId, receiverId])
  @@map("friends")
}

enum ROLE {
  USER
  ADMIN
}

enum WISH_PRIORITIES {
  LOW
  MEDIUM
  HIGH
  DREAM
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum TOKEN_TYPE {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
}
